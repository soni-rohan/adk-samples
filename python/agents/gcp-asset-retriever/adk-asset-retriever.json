          "stringValue": "function executeScript(event) {\n  // Retrieve the org_JSON parameter.\n  var orgJson \u003d event.getParameter(\"org_JSON\");\n\n  // Extract the organization ID from the JSON structure.\n  var organizationId \u003d orgJson.ancestor[1].resourceId.id;\n\n  // Set the extracted organization ID to a parameter named \"organization_ID\".\n  event.setParameter(\"organization_ID\", organizationId);\n}"
