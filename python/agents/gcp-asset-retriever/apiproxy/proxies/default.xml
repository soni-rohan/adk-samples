<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description/>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request/>
    <Step>
      <Name>EV-Request-Params</Name>
    </Step>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows>
    <Flow name="networks">
      <Description/>
      <Request>
        <Step>
          <Name>EV-Request-Params</Name>
        </Step>
        <Step>
          <Name>SIR-set-integration-request</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/networks") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="projects">
      <Description/>
      <Request>
        <Step>
          <Name>EV-Request-Params</Name>
        </Step>
        <Step>
          <Name>SIR-set-integration-request</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/projects") and (request.verb = "GET")</Condition>
    </Flow>
  </Flows>
  <HTTPProxyConnection>
    <BasePath>/adk-integration-demo</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <IntegrationEndpoint>default</IntegrationEndpoint>
  </RouteRule>
</ProxyEndpoint>
